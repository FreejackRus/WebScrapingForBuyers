MCP_HTTP_AUTH_TOKEN=change-me
MCP_HTTP_TENANT_ID=peremena

# Compose-only for marketplace-mcp (ru-marketplace-mcp 2.4.2):
# CHROME_CHALLENGE_HANDOFF_S=120 keeps a challenge tab for VNC. Not a solver.
OLLAMA_MODEL=hf.co/unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF:IQ4_XS

AUTH_SECRET=change-me
AUTH_USERS=admin:change-admin-pass:admin:Администратор:Воронеж;manager:change-manager-pass:manager:Менеджер закупок:Воронеж

# Paid Apify fallbacks are disabled until explicitly enabled.
# Four fallback Actors can run during one search; each run is capped separately.
APIFY_ENABLED=false
APIFY_TOKEN=
APIFY_MAX_ITEMS=12
APIFY_MAX_CHARGE_USD=0.20

# Local-only fake marketplace rows. Never set true in production compose.
ALLOW_DEMO_SOURCES=false

# MCP marketplaces (search + marketplace-mcp share the list in compose).
# MARKETPLACE_SOURCES=wildberries,yandex_market,ozon,dns,megamarket,citilink,avito,aliexpress,taobao

# Taobao items are CNY. Without a positive rate, Taobao offers are skipped (no fake ₽).
CNY_RUB_RATE=

# B2B / RU IT distributors — opt-in. Empty = not mounted (no fake prices).
# Docs: docs/DISTRIBUTORS.md  Example: DISTRIBUTOR_SOURCES=ocs,merlion,netlab
DISTRIBUTOR_SOURCES=
OCS_API_KEY=
OCS_API_URL=
OCS_SEARCH_PATH=
OCS_SHIPMENT_CITY=
OCS_LOCATION=
OCS_SEARCH_PATH=
OCS_SHIPMENT_CITY=
OCS_LOCATION=
MERLION_API_LOGIN=
MERLION_API_PASSWORD=
MERLION_API_TEST=
MERLION_API_URL=
NETLAB_API_LOGIN=
NETLAB_API_PASSWORD=
NETLAB_CLIENT_CODE=
NETLAB_API_URL=
SERVERMALL_API_TOKEN=
ONLINETRADE_API_TOKEN=
REGARD_API_TOKEN=
HARDPRICE_API_TOKEN=
SRVTRADE_API_TOKEN=
TORGPC_API_TOKEN=
