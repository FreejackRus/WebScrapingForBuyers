MCP_HTTP_AUTH_TOKEN=change-me
MCP_HTTP_TENANT_ID=peremena

# Compose-only for marketplace-mcp (ru-marketplace-mcp 2.4.2):
# CHROME_CHALLENGE_HANDOFF_S=120 keeps a challenge tab for VNC. Not a solver.
OLLAMA_MODEL=hf.co/unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF:IQ4_XS

AUTH_SECRET=change-me
AUTH_USERS=admin:change-admin-pass:admin:Администратор:Воронеж;manager:change-manager-pass:manager:Менеджер закупок:Воронеж

# Local-only fake marketplace rows. Never set true in production compose.
ALLOW_DEMO_SOURCES=false

# MCP marketplaces (search + marketplace-mcp share the list in compose).
# MARKETPLACE_SOURCES=wildberries,yandex_market,ozon,dns,megamarket,citilink,avito,aliexpress

# B2B / RU IT distributors — opt-in. Empty = not mounted (no fake prices).
# Docs: docs/DISTRIBUTORS.md  Example: DISTRIBUTOR_SOURCES=ocs,merlion,netlab,srvtrade,servermall (витрины и прайс NETLAB без ключей)
DISTRIBUTOR_SOURCES=
OCS_API_KEY=
OCS_API_URL=
OCS_SEARCH_PATH=
OCS_SHIPMENT_CITY=
OCS_LOCATION=
MERLION_API_LOGIN=
MERLION_API_PASSWORD=
MERLION_API_TEST=
MERLION_API_URL=
# NETLAB: price list by default; NETLAB_TRANSPORT=api switches to NLDealer REST.
NETLAB_TRANSPORT=
NETLAB_PRICE_COLUMN=R
NETLAB_PRICE_TTL_MIN=60
NETLAB_API_LOGIN=
NETLAB_API_PASSWORD=
NETLAB_CLIENT_CODE=
NETLAB_API_URL=
SERVERMALL_API_TOKEN=
ONLINETRADE_API_TOKEN=
REGARD_API_TOKEN=
HARDPRICE_API_TOKEN=
SRVTRADE_API_TOKEN=
TORGPC_API_TOKEN=

# Local inference engine. Keep Ollama variables for rollback.
AI_PROVIDER=ollama
# Switch AI_PROVIDER=vllm only after the vllm service is ready and evaluated.
VLLM_MODEL=procurement-qwen3.8-27b
VLLM_API_KEY=
VLLM_IMAGE=vllm/vllm-openai:v0.31.0@sha256:c1c9f6fd5c109ba7f0546a59f5b2f15fb87f64c77782e90a27b648b42a8e67c3
# For local development outside Compose: VLLM_BASE_URL=http://127.0.0.1:8000/v1
